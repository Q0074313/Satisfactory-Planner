# Vorlage – bei Bedarf als .env kopieren. Alle Werte sind optional; .env wird nicht eingecheckt.
# Gilt für `npm start` / `npm run dev:server` und für docker compose.

# Port (Docker: Port auf dem Host, nur 127.0.0.1)
PORT=8080
# Projektablage für `npm start` (Standard: ./storage); im Container fest /app/storage
# STORAGE_DIR=./storage

# Limits
MAX_PROJECT_BYTES=5242880
MAX_PROJECTS=5000
RATE_CREATE_PER_HOUR=10
RATE_SAVE_PER_MINUTE=120
RATE_LOAD_PER_MINUTE=300

# Nur hinter einem Proxy setzen (im Container bereits gesetzt):
# TRUST_PROXY=loopback,uniquelocal

# update.sh: Anzahl aufbewahrter Sicherungen
# BACKUP_KEEP=10
