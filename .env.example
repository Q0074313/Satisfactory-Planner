# Vorlage – als .env kopieren und Werte setzen. .env wird nicht eingecheckt.
# Lokale Entwicklung ohne PostgreSQL: eingebettete Datenbank im Ordner .data
DATABASE_URL=pglite:./.data/satis
# Zufälliger Schlüssel, mind. 32 Zeichen, z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# Nur für docker-compose.yml
POSTGRES_PASSWORD=
